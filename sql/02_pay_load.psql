\copy pay.payments        FROM '/Users/ancyrahul/Projects/payments-ops-fabric/data/payments/payments.csv'        WITH (FORMAT csv, HEADER true)
\copy pay.payment_events  FROM '/Users/ancyrahul/Projects/payments-ops-fabric/data/payments/payment_events.csv'  WITH (FORMAT csv, HEADER true)
\copy pay.rail_settlement FROM '/Users/ancyrahul/Projects/payments-ops-fabric/data/payments/rail_settlement.csv' WITH (FORMAT csv, HEADER true)
