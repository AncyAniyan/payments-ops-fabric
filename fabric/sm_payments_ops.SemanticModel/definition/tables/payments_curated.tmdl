table payments_curated
	lineageTag: 47664dbb-cd9e-4aa6-bda5-e7c48df9b9ea
	sourceLineageTag: [dbo].[payments_curated]

	measure Payments = COUNTROWS ( payments_curated )
		formatString: 0
		displayFolder: 01 Volume & Value
		lineageTag: 6db734d0-341a-490e-846b-1f1a8d7450a5

		changedProperty = Name

		changedProperty = DisplayFolder

	measure 'Value SAR' = SUM ( payments_curated[amount_sar] )
		displayFolder: 01 Volume & Value
		lineageTag: 30dd85e5-ec48-4e41-aacb-6a1b4dd5af7f

		changedProperty = Name

		changedProperty = DisplayFolder

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Final Outgoing' = ```
			
			        CALCULATE ( [Payments], payments_curated[is_final_out] = 1 )
			```
		formatString: 0
		displayFolder: 01 Volume & Value
		lineageTag: 93b375c7-d4b5-42fb-8949-e9163fd95b58

		changedProperty = Name

		changedProperty = DisplayFolder

	measure 'Settled Value OUT' = CALCULATE ( [Value SAR], payments_curated[direction] = "OUT", payments_curated[final_status] = "SETTLED" )
		displayFolder: 01 Volume & Value
		lineageTag: f588c759-5a7e-4b6f-80c6-125aa2d8ed88

		changedProperty = Name

		changedProperty = DisplayFolder

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'STP Rate' = ```
			
			VAR FinalOut = 
			    CALCULATE ( 
			        [Payments], 
			        payments_curated[direction] = "OUT", 
			        payments_curated[final_status] IN { "SETTLED", "REJECTED", "RETURNED" } 
			    )
			VAR STPCount = 
			    CALCULATE ( 
			        [Payments], 
			        payments_curated[direction] = "OUT", 
			        payments_curated[final_status] IN { "SETTLED", "REJECTED", "RETURNED" },
			        payments_curated[is_stp] = TRUE ()
			    )
			RETURN
			    DIVIDE ( STPCount, FinalOut )
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 02 Performance & SLA
		lineageTag: 3a2f28ed-fa3d-4d68-a44a-f7475b3ce319

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

	measure Rejected = CALCULATE ( [Payments], payments_curated[final_status] = "REJECTED" )
		formatString: 0
		displayFolder: 02 Performance & SLA
		lineageTag: 8191592c-859e-4598-9826-7c1d66440dc3

		changedProperty = Name

		changedProperty = DisplayFolder

	measure 'Rejection Rate' = DIVIDE ( [Rejected], [Payments] )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 02 Performance & SLA
		lineageTag: 8e7e9063-479e-4fd2-8ca9-7fd54bdaa18a

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

	measure 'Median Settle Seconds' = MEDIAN ( settle_times[seconds_to_settle] )
		displayFolder: 02 Performance & SLA
		lineageTag: fbe4a832-35d3-456e-9c9c-3ec27aafd313

		changedProperty = Name

		changedProperty = DisplayFolder

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'P95 Settle Seconds' = PERCENTILE.INC ( settle_times[seconds_to_settle], 0.95 )
		displayFolder: 02 Performance & SLA
		lineageTag: 16831103-9a43-48d2-bd8c-89ef1704da1f

		changedProperty = Name

		changedProperty = DisplayFolder

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'SARIE Outside-Window Share' = ```
			
			DIVIDE ( 
			    CALCULATE ( [Payments], payments_curated[sarie_outside_window] = 1 ), 
			    CALCULATE ( [Payments], payments_curated[rail] = "SARIE", payments_curated[direction] = "OUT" ) 
			)
			```
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 02 Performance & SLA
		lineageTag: 29f9a4c1-7b59-4bdc-93f9-f74c20807429

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

	measure 'Recon Items' = COUNTROWS ( recon_items )
		formatString: 0
		displayFolder: 03 Reconciliation
		lineageTag: 274618e2-8a4b-4ef6-9f31-b5476ee0c294

		changedProperty = Name

		changedProperty = DisplayFolder

	measure 'Recon Breaks' = CALCULATE ( [Recon Items], recon_items[category] <> "matched" )
		formatString: 0
		displayFolder: 03 Reconciliation
		lineageTag: 7604b4cb-5dc4-46ba-90d3-cf3b3c588701

		changedProperty = Name

		changedProperty = DisplayFolder

	measure 'P95 Settle Minutes' = DIVIDE ( [P95 Settle Seconds], 60 )
		formatString: 0.0
		displayFolder: 02 Performance & SLA
		lineageTag: 3ed1ae48-3720-47e1-b048-5bd02bf45429

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

